{
  "name": "english-studio-backend",
  "version": "1.0.0",
  "description": "Backend Node.js com Express e PostgreSQL para sistema de aulas de inglês.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:apply": "node scripts/applySchema.js",
    "db:apply:production": "node scripts/applySchema.js --production --env-path=.env.production",
    "deploy:check": "node scripts/checkDeployReady.js --strict",
    "deploy:check:production": "node scripts/checkDeployReady.js --production --env-path=.env.production --strict",
    "deploy:check:local": "node scripts/checkDeployReady.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:admin:production": "node scripts/seedAdmin.js --production --env-path=.env.production",
    "test:admin-flow": "node scripts/testAdminFlow.js",
    "test:security": "node scripts/testSecurityFlow.js",
    "test:uploads": "node scripts/testUploadFlow.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
