PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=english_studio
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
SUPABASE_STORAGE_BUCKET=english-studio-materials

JWT_SECRET=replace_with_a_long_random_secret_before_deploy
JWT_ISSUER=english-studio
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

ADMIN_NAME=Teacher Admin
ADMIN_EMAIL=admin@english.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
