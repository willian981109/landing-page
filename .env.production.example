NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://your-domain.com

# Prefer DATABASE_URL in production. Most hosts provide this value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace_with_supabase_server_secret
SUPABASE_STORAGE_BUCKET=english-studio-materials

JWT_SECRET=replace_with_a_long_random_secret_before_deploy
JWT_ISSUER=english-studio
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

ADMIN_NAME=Teacher Admin
ADMIN_EMAIL=admin@english.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
