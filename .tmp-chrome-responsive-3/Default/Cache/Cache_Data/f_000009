:root {
  --green-900: #1f3d2b;
  --green-800: #294b36;
  --olive: #74825b;
  --gold: #c2a46f;
  --cream: #f5f5f0;
  --white: #ffffff;
  --ink: #1d241f;
  --muted: #6f766f;
  --line: rgba(31, 61, 43, 0.14);
  --shadow: 0 24px 80px rgba(20, 36, 27, 0.16);
  --serif: "Playfair Display", Georgia, serif;
  --sans: "Inter", Arial, sans-serif;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background:
    linear-gradient(140deg, rgba(31, 61, 43, 0.06), transparent 34%),
    var(--cream);
  color: var(--ink);
  font-family: var(--sans);
  line-height: 1.6;
}

button,
a,
input,
select,
textarea {
  color: inherit;
  font: inherit;
}

a {
  text-decoration: none;
}

button {
  cursor: pointer;
}

.teacher-header {
  align-items: center;
  background: rgba(245, 245, 240, 0.9);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--line);
  display: flex;
  gap: 1rem;
  justify-content: space-between;
  padding: 1rem clamp(1rem, 4vw, 2rem);
  position: sticky;
  top: 0;
  z-index: 20;
}

.brand {
  align-items: center;
  display: inline-flex;
  gap: 0.72rem;
}

.brand__mark {
  align-items: center;
  background: var(--green-900);
  border: 1px solid rgba(194, 164, 111, 0.45);
  color: var(--gold);
  display: inline-flex;
  font-family: var(--serif);
  font-size: 1.05rem;
  height: 2.35rem;
  justify-content: center;
  width: 2.35rem;
}

.brand__text {
  color: var(--green-900);
  font-size: 0.84rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.teacher-header__actions {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
  justify-content: flex-end;
}

.header-link,
.logout-link {
  background: transparent;
  border: 0;
  border-bottom: 1px solid rgba(194, 164, 111, 0.58);
  color: var(--green-900);
  font-size: 0.8rem;
  font-weight: 800;
  padding: 0;
  text-transform: uppercase;
}

.teacher-main {
  margin: 0 auto;
  max-width: 1320px;
  padding: clamp(1.35rem, 4vw, 4rem);
}

.view-heading {
  margin-bottom: clamp(1.5rem, 4vw, 2.6rem);
  max-width: 840px;
}

.eyebrow,
.panel-label {
  color: var(--gold);
  display: block;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  margin: 0 0 0.8rem;
  text-transform: uppercase;
}

.panel-label {
  color: var(--olive);
  font-size: 0.76rem;
  letter-spacing: 0.14em;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1,
h2,
h3 {
  color: var(--green-900);
  font-family: var(--serif);
  font-weight: 700;
  line-height: 1.05;
}

h1 {
  font-size: clamp(2.35rem, 6vw, 4.4rem);
  margin-bottom: 0.65rem;
}

h2 {
  font-size: clamp(1.35rem, 3vw, 2rem);
  margin-bottom: 0;
}

h3 {
  font-size: 1.25rem;
  margin-bottom: 0.4rem;
}

.view-heading p:not(.eyebrow),
.muted-text,
.empty-state p,
.detail-heading p,
.detail-section p,
.detail-grid small {
  color: var(--muted);
}

.metric-grid {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-bottom: 1rem;
}

.metric-card,
.student-selector-panel,
.pedagogical-profile-panel,
.activity-panel,
.detail-panel,
.empty-state {
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid var(--line);
  box-shadow: 0 16px 48px rgba(20, 36, 27, 0.08);
}

.metric-card {
  padding: 1rem;
}

.metric-card .panel-label {
  margin-bottom: 0.45rem;
}

.metric-card strong {
  color: var(--green-900);
  display: block;
  font-family: var(--serif);
  font-size: clamp(1.9rem, 5vw, 3rem);
  line-height: 1;
}

.metric-card--reviewed {
  border-color: rgba(194, 164, 111, 0.48);
}

.student-selector-panel {
  align-items: end;
  display: grid;
  gap: 1rem;
  margin-bottom: 1rem;
  padding: clamp(1rem, 3vw, 1.35rem);
}

.student-selector-panel h2 {
  margin-bottom: 0.35rem;
}

.student-selector-panel p {
  color: var(--muted);
  margin: 0;
}

.student-filter-field select:disabled {
  cursor: wait;
  opacity: 0.68;
}

.pedagogical-profile-panel {
  margin-bottom: 1rem;
  padding: clamp(1rem, 3vw, 1.45rem);
}

.pedagogical-profile-form,
.pedagogical-profile-heading {
  display: grid;
  gap: 1rem;
}

.pedagogical-profile-heading {
  align-items: start;
}

.pedagogical-profile-panel p,
.pedagogical-profile-heading p,
.pedagogical-profile-heading small {
  color: var(--muted);
  margin: 0;
}

.profile-rating-grid {
  display: grid;
  gap: 0.75rem;
}

.profile-rating-row {
  align-items: center;
  background: rgba(245, 245, 240, 0.72);
  border: 1px solid rgba(31, 61, 43, 0.12);
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  justify-content: space-between;
  padding: 0.85rem;
}

.profile-rating-row > span {
  color: var(--green-900);
  font-weight: 800;
}

.profile-stars {
  display: inline-flex;
  gap: 0.15rem;
}

.profile-star {
  background: transparent;
  border: 0;
  color: rgba(194, 164, 111, 0.48);
  font-size: 1.25rem;
  line-height: 1;
  min-height: 2rem;
  min-width: 2rem;
  padding: 0.2rem;
  transition: color 180ms ease, transform 180ms ease;
}

.profile-star:hover,
.profile-star.is-active {
  color: var(--gold);
}

.profile-star:hover {
  transform: translateY(-1px);
}

.profile-comment-field {
  margin-top: 0.1rem;
}

.pedagogical-profile-summary {
  align-items: center;
  display: grid;
  gap: 1rem;
}

.pedagogical-profile-summary h2 {
  margin-bottom: 0.35rem;
}

.profile-toggle-button {
  align-items: center;
  background: rgba(245, 245, 240, 0.82);
  border: 1px solid rgba(194, 164, 111, 0.58);
  color: var(--green-900);
  display: inline-flex;
  font-size: 0.76rem;
  font-weight: 800;
  gap: 0.5rem;
  justify-content: center;
  min-height: 2.75rem;
  padding: 0.7rem 0.9rem;
  text-transform: uppercase;
  transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
}

.profile-toggle-button:hover {
  background: var(--white);
  border-color: var(--gold);
  transform: translateY(-1px);
}

.profile-toggle-button__icon {
  display: inline-block;
  font-size: 1rem;
  line-height: 1;
  transition: transform 220ms ease;
}

.pedagogical-profile-form.is-expanded .profile-toggle-button__icon {
  transform: rotate(180deg);
}

.profile-collapsible {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  pointer-events: none;
  transform: translateY(-0.35rem);
  transition: max-height 320ms ease, opacity 240ms ease, transform 240ms ease, margin-top 240ms ease;
}

.pedagogical-profile-form.is-expanded .profile-collapsible {
  margin-top: 1rem;
  max-height: 900px;
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.dashboard-layout {
  display: grid;
  gap: 1rem;
}

.activity-panel,
.detail-panel {
  padding: clamp(1rem, 3vw, 1.6rem);
}

.panel-toolbar {
  align-items: end;
  display: grid;
  gap: 1rem;
  margin-bottom: 1rem;
}

.filter-field,
.field {
  display: grid;
  gap: 0.45rem;
}

.filter-field span,
.field span {
  color: rgba(31, 61, 43, 0.78);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.filter-field select,
.field input,
.field textarea {
  background: rgba(245, 245, 240, 0.72);
  border: 1px solid rgba(31, 61, 43, 0.16);
  min-height: 3rem;
  outline: 0;
  padding: 0.78rem 0.9rem;
  transition: background 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  width: 100%;
}

.field textarea {
  resize: vertical;
}

.filter-field select:focus,
.field input:focus,
.field textarea:focus {
  background: var(--white);
  border-color: rgba(194, 164, 111, 0.8);
  box-shadow: 0 0 0 3px rgba(194, 164, 111, 0.16);
}

.assignment-list {
  display: grid;
  gap: 0.7rem;
}

.assignment-row {
  align-items: start;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid var(--line);
  display: grid;
  gap: 0.75rem;
  padding: 0.95rem;
  text-align: left;
  transition: background 180ms ease, border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  width: 100%;
}

.assignment-row:hover,
.assignment-row.active {
  background: var(--white);
  border-color: rgba(194, 164, 111, 0.62);
  box-shadow: 0 14px 36px rgba(20, 36, 27, 0.1);
  transform: translateY(-1px);
}

.assignment-row__main {
  display: grid;
  gap: 0.15rem;
}

.assignment-row__main strong {
  color: var(--green-900);
  font-size: 1.02rem;
  line-height: 1.25;
}

.assignment-row__main small {
  color: var(--muted);
}

.assignment-row__meta {
  color: var(--muted);
  display: grid;
  gap: 0.3rem;
  font-size: 0.82rem;
}

.assignment-row__meta strong {
  color: var(--green-900);
}

.status {
  align-items: center;
  border: 1px solid rgba(31, 61, 43, 0.18);
  color: var(--green-900);
  display: inline-flex;
  font-size: 0.72rem;
  font-weight: 800;
  justify-content: center;
  min-height: 1.9rem;
  padding: 0.35rem 0.65rem;
  text-transform: uppercase;
  width: max-content;
}

.status--pending {
  background: rgba(122, 62, 47, 0.1);
  border-color: rgba(122, 62, 47, 0.24);
  color: #7a3e2f;
}

.status--in-progress,
.status--completed {
  background: rgba(194, 164, 111, 0.18);
  border-color: rgba(194, 164, 111, 0.44);
}

.status--reviewed {
  background: rgba(31, 61, 43, 0.08);
  border-color: rgba(31, 61, 43, 0.2);
}

.dashboard-message {
  background: rgba(31, 61, 43, 0.08);
  border: 1px solid rgba(31, 61, 43, 0.18);
  color: var(--green-900);
  font-weight: 800;
  margin: 0;
  padding: 0.85rem 0.95rem;
}

.empty-state {
  padding: clamp(1rem, 3vw, 1.5rem);
}

.detail-panel {
  align-self: start;
}

.review-form {
  display: grid;
  gap: 1.1rem;
}

.detail-heading {
  border-bottom: 1px solid var(--line);
  display: grid;
  gap: 0.5rem;
  padding-bottom: 1rem;
}

.detail-heading h2 {
  margin-bottom: 0;
}

.detail-heading p {
  margin-bottom: 0;
}

.detail-section,
.correction-box {
  border-bottom: 1px solid var(--line);
  display: grid;
  gap: 0.75rem;
  padding-bottom: 1rem;
}

.detail-section:last-child,
.correction-box {
  border-bottom: 0;
}

.detail-section p {
  margin-bottom: 0;
}

.detail-grid {
  display: grid;
  gap: 0.75rem;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.detail-grid article {
  background: rgba(245, 245, 240, 0.72);
  border: 1px solid rgba(31, 61, 43, 0.12);
  display: grid;
  gap: 0.2rem;
  padding: 0.85rem;
}

.detail-grid strong {
  color: var(--green-900);
}

.material-list {
  display: grid;
  gap: 0.65rem;
}

.material-item {
  align-items: center;
  background: rgba(194, 164, 111, 0.1);
  border: 1px solid rgba(194, 164, 111, 0.34);
  display: grid;
  gap: 0.75rem;
  grid-template-columns: auto 1fr auto;
  padding: 0.75rem;
}

.material-item__icon {
  align-items: center;
  background: var(--green-900);
  color: var(--white);
  display: inline-flex;
  font-size: 0.68rem;
  font-weight: 800;
  height: 2.4rem;
  justify-content: center;
  width: 2.4rem;
}

.material-item__icon--pdf {
  background: #7a3e2f;
}

.material-item__icon--link,
.material-item__icon--docs,
.material-item__icon--audio,
.material-item__icon--video {
  background: var(--olive);
}

.material-item__content {
  display: grid;
  gap: 0.05rem;
}

.material-item__content strong {
  color: var(--green-900);
  line-height: 1.2;
}

.material-item__content small {
  color: var(--muted);
}

.material-item a {
  border: 1px solid var(--gold);
  color: var(--green-900);
  font-size: 0.72rem;
  font-weight: 800;
  justify-self: end;
  min-height: 2.25rem;
  padding: 0.5rem 0.75rem;
  text-transform: uppercase;
}

.correction-box {
  background: rgba(31, 61, 43, 0.04);
  border: 1px solid rgba(31, 61, 43, 0.1);
  padding: 1rem;
}

.publish-button {
  align-items: center;
  background: var(--gold);
  border: 1px solid transparent;
  color: var(--green-900);
  display: inline-flex;
  font-size: 0.78rem;
  font-weight: 800;
  justify-content: center;
  min-height: 3rem;
  padding: 0.78rem 1rem;
  text-transform: uppercase;
  transition: background 180ms ease, transform 180ms ease;
  width: 100%;
}

.publish-button:hover {
  background: #d0b37a;
  transform: translateY(-1px);
}

@media (min-width: 720px) {
  .metric-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .student-selector-panel {
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.36fr);
  }

  .pedagogical-profile-summary {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .panel-toolbar {
    grid-template-columns: 1fr minmax(180px, 0.32fr);
  }

  .pedagogical-profile-heading {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .profile-rating-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .assignment-row {
    grid-template-columns: auto minmax(0, 1fr) minmax(180px, 0.38fr);
  }
}

@media (min-width: 1040px) {
  .dashboard-layout {
    align-items: start;
    grid-template-columns: minmax(0, 1.05fr) minmax(380px, 0.8fr);
  }

  .detail-panel {
    position: sticky;
    top: 6rem;
  }
}

@media (max-width: 620px) {
  .teacher-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .detail-grid {
    grid-template-columns: 1fr;
  }

  .material-item {
    grid-template-columns: auto 1fr;
  }

  .material-item a {
    grid-column: 1 / -1;
    justify-self: stretch;
    text-align: center;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* Premium light visual system */
:root {
  --green-900: #0f2a21;
  --green-800: #183d30;
  --olive: #596b4f;
  --gold: #c4a15a;
  --cream: #fffaf2;
  --white: #ffffff;
  --ink: #17211b;
  --muted: #667268;
  --line: rgba(15, 42, 33, 0.13);
  --shadow: 0 24px 80px rgba(15, 42, 33, 0.1);
  --radius-sm: 0.55rem;
  --radius-md: 0.85rem;
  --radius-lg: 1.1rem;
}

body {
  background:
    radial-gradient(circle at 12% 8%, rgba(196, 161, 90, 0.12), transparent 26rem),
    radial-gradient(circle at 88% 16%, rgba(15, 42, 33, 0.08), transparent 30rem),
    linear-gradient(180deg, #fffdf8 0%, var(--cream) 100%);
}

.teacher-header,
.metric-card,
.student-selector-panel,
.pedagogical-profile-panel,
.activity-panel,
.detail-panel,
.empty-state,
.profile-rating-row,
.profile-toggle-button,
.profile-collapsible,
.assignment-row,
.status,
.dashboard-message,
.detail-grid article,
.material-item,
.material-item a,
.correction-box,
.publish-button,
input,
select,
textarea,
button {
  border-radius: var(--radius-md);
}

.brand__mark,
.material-item__icon,
.profile-star {
  border-radius: var(--radius-sm);
}

.teacher-header {
  background: rgba(255, 250, 242, 0.9);
  box-shadow: 0 12px 42px rgba(15, 42, 33, 0.05);
}

.metric-card,
.student-selector-panel,
.pedagogical-profile-panel,
.activity-panel,
.detail-panel,
.empty-state {
  background: rgba(255, 255, 255, 0.8);
  border-color: rgba(15, 42, 33, 0.12);
  box-shadow: var(--shadow);
}

.filter-field select,
.field input,
.field textarea,
.profile-rating-row,
.detail-grid article,
.assignment-row,
.correction-box {
  background: rgba(255, 250, 242, 0.72);
  border-color: rgba(15, 42, 33, 0.12);
}

.assignment-row:hover,
.assignment-row.active {
  border-color: rgba(196, 161, 90, 0.62);
  box-shadow: 0 18px 54px rgba(15, 42, 33, 0.11);
}

.profile-toggle-button {
  background: rgba(255, 255, 255, 0.78);
}

.publish-button {
  background: var(--gold);
}

/* Responsive hardening for pedagogical dashboard */
html,
body {
  max-width: 100%;
  overflow-x: clip;
}

img,
svg,
canvas {
  height: auto;
  max-width: 100%;
}

.teacher-header,
.teacher-shell,
.teacher-main,
.metric-grid,
.student-selector-panel,
.pedagogical-profile-panel,
.dashboard-layout,
.assignment-list,
.assignment-row,
.detail-panel,
.material-list,
.material-item {
  max-width: 100%;
  min-width: 0;
}

button,
a,
input,
select,
textarea {
  max-width: 100%;
  overflow-wrap: anywhere;
}

@media (max-width: 1200px) {
  .dashboard-layout {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 992px) {
  .teacher-main {
    padding-inline: clamp(1rem, 4vw, 2rem);
  }
}

@media (max-width: 768px) {
  .teacher-header,
  .pedagogical-profile-heading,
  .pedagogical-profile-summary {
    align-items: flex-start;
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 576px) {
  h1,
  h2,
  h3,
  .header-link,
  .logout-link {
    overflow-wrap: anywhere;
  }

  h1 {
    font-size: clamp(1.85rem, 11vw, 2.45rem);
  }

  .teacher-header__actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
  }

  .header-link,
  .logout-link {
    justify-self: stretch;
    text-align: left;
  }

  .metric-grid,
  .student-selector-panel,
  .profile-rating-grid,
  .panel-toolbar,
  .assignment-row,
  .detail-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
